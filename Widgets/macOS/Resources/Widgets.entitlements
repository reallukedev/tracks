<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- The whole reason the widget can show anything: it opens the same store the app
         writes, read-only. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TRACKS_APP_GROUP)</string>
    </array>

    <!-- Album artwork is fetched by URL in the timeline provider, because a widget cannot
         load an image asynchronously while rendering. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
