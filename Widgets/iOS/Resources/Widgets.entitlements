<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Lets the widget open the app's store read-only. iOS extensions are sandboxed by
         default and outbound network needs no entitlement. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TRACKS_APP_GROUP)</string>
    </array>
</dict>
</plist>
