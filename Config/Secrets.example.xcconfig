// Copy to Secrets.xcconfig (gitignored) and fill in.
//
// From https://www.last.fm/api/account/create. The API key and shared secret identify the
// application, not you. The secret signs authenticated requests, so keep it out of commits.
TRACKS_LASTFM_API_KEY = your-api-key
TRACKS_LASTFM_SECRET = your-shared-secret

// SharePlay's relay: a Supabase project's host, like abcdefghijkl.supabase.co (no https://,
// since // starts a comment here), and its publishable key (sb_publishable_…), from the
// project's API Keys settings. Publishable keys are meant to ship in apps.
TRACKS_RELAY_HOST = your-project.supabase.co
TRACKS_RELAY_KEY = sb_publishable_your-key
