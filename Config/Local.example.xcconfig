// Copy to Local.xcconfig (gitignored) and fill in.
//
// Only needed to run on a device or build the signed Mac app. The simulator and an
// unsigned Mac build (`./build.sh ci`) work from a clean checkout.
//
// Your 10-character Team ID, from https://developer.apple.com/account under Membership.
DEVELOPMENT_TEAM = ABCDE12345

// Any reverse-DNS identifier you own. Register it as an Explicit App ID with MusicKit
// ticked under App Services, or catalog search and play-back fail with
// `developerTokenRequestFailed`. The App Group and iCloud container are derived from it.
// The App Clip names its parent app literally, so change the identifier in
// Apps/Clip/Resources/TracksClip.entitlements to match.
TRACKS_BUNDLE_ID = com.example.Tracks

// Your team can't join Motif's App Group, which belongs to the maintainer's team, or use
// Tracks' CarPlay grant. These point your build at a group of your own and at the
// entitlements without CarPlay.
TRACKS_MOTIF_APP_GROUP[sdk=iphoneos*]        = group.$(TRACKS_BUNDLE_ID).motif
TRACKS_MOTIF_APP_GROUP[sdk=iphonesimulator*] = group.$(TRACKS_BUNDLE_ID).motif
TRACKS_MOTIF_APP_GROUP[sdk=macosx*]          = $(DEVELOPMENT_TEAM).group.$(TRACKS_BUNDLE_ID).motif
TRACKS_IOS_ENTITLEMENTS = Apps/iOS/Resources/Tracks.entitlements
